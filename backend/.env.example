# Backend environment variables (copy to .env and fill in)
PORT=8000
NODE_ENV=development

# Database
MONGO_URI=

# Clerk authentication (https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stream video & chat (https://dashboard.getstream.io)
STREAM_API_KEY=
STREAM_API_SECRET=

# Error monitoring
SENTRY_DSN=

# Background jobs
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# OpenAI
OPENAI_API_KEY=

# Nari Labs TTS (https://app.narilabs.com/keys)
# Server-side secret only — never expose to the frontend.
NARI_API_KEY=

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173
